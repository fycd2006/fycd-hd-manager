# 複製成 .env.local 後填入實際值：cp .env.example .env.local
# 不要把 .env.local 或任何真實金鑰 commit 進 repo。

# ── 必填 ──
# TiDB / MySQL 連線字串
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/DATABASE?sslaccept=strict"
# Session 簽章金鑰，至少 32 字元（可用 `openssl rand -base64 48` 產生）
SESSION_SECRET=""

# ── 選填 ──
# 網站對外網址（metadata 用），預設 http://localhost:3000
NEXT_PUBLIC_APP_URL=""

# Redis：限流與快取，未設定時自動降級
REDIS_URL=""

# 排程端點 /api/cron/* 的 Bearer token；未設定時排程端點拒絕執行
CRON_SECRET=""

# Pusher 即時同步；APP_ID／KEY／SECRET 未設齊時不廣播，CLUSTER 預設 ap1
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# Gemini：AI 資料表助理（/api/ai/table-agent）
GEMINI_API_KEY=""
# 優先使用的模型，未設定時用內建清單
GEMINI_MODEL=""

# Resend：寄送密碼重設信；未設定時不寄信，重設連結只寫進伺服器 log
RESEND_API_KEY=""
# 預設 "FYCD HD Manager <onboarding@resend.dev>"
RESEND_FROM_EMAIL=""
