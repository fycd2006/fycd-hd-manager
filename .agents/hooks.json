{
  "pre-command-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-commit-verify.mjs",
            "timeout": 900
          }
        ]
      }
    ]
  },
  "post-edit-lint": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/post-edit-lint.mjs",
            "timeout": 60
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/post-invocation-lint.mjs",
        "timeout": 30
      }
    ]
  }
}
