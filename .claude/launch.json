{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-cache-worktree",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "C:/dev/fycd-hd-manager-cache",
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "prod-cache-worktree",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "C:/dev/fycd-hd-manager-cache",
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    }
  ]
}
